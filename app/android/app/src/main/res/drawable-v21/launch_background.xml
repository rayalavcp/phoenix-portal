<?xml version="1.0" encoding="utf-8"?>
<!-- Phoenix Portal launch screen: the flame phoenix centred on deep ink, the
     kiosk's own dark background, so start-up never flashes white. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#FF0F1115" />
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
