<?xml version="1.0" encoding="utf-8"?>
<!-- Phoenix Portal adaptive icon background: deep ink with a warm ember glow behind
     the mark. 432dp intrinsic size so launchers that rasterize at intrinsic size
     (Meta's draws 152px tiles on an mdpi panel) stay sharp. Paired with
     the phoenix foreground (drawable-nodpi, from assets/branding/mark.png). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="432dp" android:height="432dp"
    android:viewportWidth="100" android:viewportHeight="100">
    <path android:pathData="M0 0h100v100H0z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="50" android:centerY="38" android:gradientRadius="72">
                <item android:color="#FF3A1E16" android:offset="0"/>
                <item android:color="#FF181B22" android:offset="0.55"/>
                <item android:color="#FF0B0D10" android:offset="1"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
